{
  "include": ["../corpus"],
  "exclude": ["**/__pycache__"],
  "typeCheckingMode": "strict",
  "pythonVersion": "${python_version}",
  "pythonPlatform": "Linux",
  "useLibraryCodeForTypes": false,
  "reportMissingTypeStubs": true,
  "reportImplicitOverride": true,
  "venvPath": "${venv_parent}",
  "venv": "${venv_name}"
}
